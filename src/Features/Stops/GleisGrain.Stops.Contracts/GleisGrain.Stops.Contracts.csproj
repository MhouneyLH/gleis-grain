<Project Sdk="Microsoft.NET.Sdk">

  <!-- One property picks the grain interface version of the build: dotnet build -p:GrainVersion=2 -->
  <PropertyGroup>
    <GrainVersion Condition="'$(GrainVersion)' == ''">1</GrainVersion>
    <DefineConstants Condition="'$(GrainVersion)' == '2'">$(DefineConstants);GRAIN_V2</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Sdk" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../Common.Abstractions/GleisGrain.Common.Abstractions.csproj" />
    <ProjectReference Include="../../Trips/GleisGrain.Trips.Contracts/GleisGrain.Trips.Contracts.csproj" />
  </ItemGroup>

</Project>
