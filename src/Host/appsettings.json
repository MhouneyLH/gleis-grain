{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Orleans": {
    "SiloPort": 11111,
    "GatewayPort": 30000,
    "EnableDashboard": true
  },
  "Stops": {
    "ReminderPeriod": "00:01:00",
    "WatchedRefreshPeriod": "00:00:15",
    "BoardMaxAge": "00:00:30",
    "UseBoardCache": false,
    "BoardCacheTtl": "00:00:05"
  },
  "Alerts": {
    "ReminderPeriod": "00:01:00"
  },
  "Ingestion": {
    "Mode": "Live",
    "MinimumCallInterval": "00:00:00.500",
    "DepartureCacheTtl": "00:00:20",
    "NoticeCacheTtl": "00:01:00"
  },
  "Game": {
    "ResolvePeriod": "00:01:00"
  },
  "Cluster": {
    "EnableChaos": false
  }
}
