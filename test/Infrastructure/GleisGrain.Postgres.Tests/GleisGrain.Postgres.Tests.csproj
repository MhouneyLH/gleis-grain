<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Microsoft.Orleans.TestingHost" />
    <PackageReference Include="Microsoft.Orleans.Server" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Common/GleisGrain.Common.csproj" />
  </ItemGroup>

  <!-- The SQL scripts of the repo, linked and not copied: the test loads the very same files as the AppHost. -->
